{
  "name": "analytics-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./apps/server/test/replay/shared-alias.ts apps/server/test/replay/bench.ts",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
