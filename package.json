{
  "name": "featherstat",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./apps/server/test/replay/shared-alias.ts apps/server/test/replay/bench.ts",
    "build": "bun run --cwd packages/tracker build && bun run --cwd apps/web build && bun run --cwd apps/server build",
    "check": "biome check --error-on-warnings . && tsc --noEmit && tsc --noEmit -p packages/tracker && tsc --noEmit -p test/contract && bun run --cwd apps/web check",
    "ci": "bash scripts/ci.sh",
    "e2e": "playwright test --config test/e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "happy-dom": "^20.11.1",
    "typescript": "~6",
    "vitest": "^4.1.10"
  }
}
